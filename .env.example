# LLM provider: offline | anthropic | ollama
CONEXUS_LLM=offline
# Anthropic (Claude) - or use `ant auth login` instead of a key
ANTHROPIC_API_KEY=
CONEXUS_ANTHROPIC_MODEL=claude-opus-5-5
CONEXUS_EFFORT=low
# Ollama (local, free)
CONEXUS_OLLAMA_MODEL=llama3.1:8b
OLLAMA_HOST=http://localhost:11434
# Optional integrations
SLACK_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
