# LLM provider: offline | anthropic | ollama
CONEXUS_LLM=offline
# Anthropic (Claude) - or use `ant auth login` instead of a key
ANTHROPIC_API_KEY=
CONEXUS_ANTHROPIC_MODEL=claude-opus-5-5
CONEXUS_EFFORT=low
# Ollama (local, free)
CONEXUS_OLLAMA_MODEL=llama3.1:8b
OLLAMA_HOST=http://localhost:11434
# Optional integrations
SLACK_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# First admin account (created on first start if no users exist). Otherwise use the
# setup screen, or: conexus create-user you@company.com --name "You" --role admin
CONEXUS_ADMIN_EMAIL=
CONEXUS_ADMIN_PASSWORD=
# Shared secret your mail provider sends as X-Conexus-Webhook-Token on inbound replies
CONEXUS_WEBHOOK_TOKEN=
# One-click "Try the demo" button (Legal-level demo account with sample deals). 1 = on
CONEXUS_DEMO=1
