# LLM provider: offline | anthropic | ollama
CONEXUS_LLM=offline
# Anthropic (Claude) - or use `ant auth login` instead of a key
ANTHROPIC_API_KEY=
CONEXUS_ANTHROPIC_MODEL=claude-opus-5-5
CONEXUS_EFFORT=low
# Ollama (local, free)
CONEXUS_OLLAMA_MODEL=llama3.1:8b
OLLAMA_HOST=http://localhost:11434
# Optional integrations
SLACK_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# First admin account (created on first start if no users exist). Otherwise use the
# setup screen, or: conexus create-user you@company.com --name "You" --role admin
CONEXUS_ADMIN_EMAIL=
CONEXUS_ADMIN_PASSWORD=
# Shared secret your mail provider sends as X-Conexus-Webhook-Token on inbound replies
CONEXUS_WEBHOOK_TOKEN=
# One-click "Try the demo" button (Legal-level demo account with sample deals). 1 = on
CONEXUS_DEMO=1
# Self sign-up with e-mail verification (new accounts get the Sales role). 1 = on
CONEXUS_SIGNUP=1
# Public address used in e-mailed links, e.g. https://conexus.onrender.com
CONEXUS_PUBLIC_URL=
# Sender address shown in e-mails (defaults to SMTP_USER)
SMTP_FROM=
# LOCAL DEVELOPMENT ONLY: show verification/reset links on screen when SMTP is not set.
# Never enable on a public server (anyone could reset anyone's password).
CONEXUS_DEV_EMAIL_LINKS=0
